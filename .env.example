VITE_SUPABASE_URL=https://gxmaxbjgdrqdcizvdojp.supabase.co

# Prefer legacy anon JWT (Settings → API → anon public). Works with @supabase/supabase-js today.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Optional: publishable key (sb_publishable_*) — only if your supabase-js version supports it
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY_HERE

# =============================================================================
# Edge secrets — NEVER VITE_ for LLM / Evolution
# Local serve: supabase functions serve --env-file .env.local
# Prod push:   .\scripts\push-edge-secrets.ps1 -ProjectRef gxmaxbjgdrqdcizvdojp
# Ops: docs/superpowers/ops/2026-07-24-evolution-sakana-best-fit.md
# =============================================================================
CHANNEL_PROVIDER=evolution
LLM_PROVIDER=sakana
EROS_AUTO_REPLY=false

SAKANA_API_KEY=YOUR_SAKANA_API_KEY_HERE
SAKANA_BASE_URL=https://api.sakana.ai/v1
SAKANA_MODEL=fugu
# SAKANA_TIMEOUT_MS=120000

EVOLUTION_URL=https://your-evolution-host
EVOLUTION_INSTANCE=your-instance
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY
# Optional separate webhook secret (defaults to EVOLUTION_API_KEY)
# EVOLUTION_WEBHOOK_SECRET=

# --- Alternates ---
# OLLAMA_BASE_URL=https://ollama2.vectracargo.com.br/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=ollama
# Túnel público (Cloudflare) — Edge Functions usam este host, não 127.0.0.1
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# --- RAG embeddings — dim 1024; default local Ollama (free) ---
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=mxbai-embed-large
# OLLAMA_BASE_URL=https://ollama2.vectracargo.com.br
# (alt local) OLLAMA_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_VERSION=1
# EMBEDDING_DIMENSION=1024
# NÃO use nomic-embed-text (768 ≠ schema). Edge cloud NÃO alcança 127.0.0.1.
# Paid alt: EMBEDDING_PROVIDER=voyage + EMBEDDING_MODEL=voyage-4-large + VOYAGE_API_KEY=
# EMBEDDING_API_KEY=  # alias scripts/ingest-totalpass.ts
# RAG_TOP_K=15
# RAG_MIN_SIMILARITY=0.6

# --- Ingest TP (Node script) ---
# SUPABASE_URL=https://gxmaxbjgdrqdcizvdojp.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# TARGET_GROUP_ID=   # opcional; capital ingest cria "TotalPass SP Capital" se vazio
# TARGET_TENANT_ID=  # opcional; vazio = global
# TOTALPASS_GROUP_ID= # scripts/ingest-totalpass-sp.ts (estado) — obrigatório
# INPUT_PATH=data/processed/totalpass-sp-all.json
# BATCH_SIZE=50
# --- Embed job (scripts/generate-embeddings.ts) ---
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=mxbai-embed-large
# EMBEDDING_VERSION=1
# OLLAMA_BASE_URL=https://ollama2.vectracargo.com.br
# DELAY_MS=200
# LIMIT=20   # teste; 0 = todos pending
