{
  "version": 1,
  "purpose": "Golden do CONSULTOR LOGADO — pipeline completo (5 especialistas + tools + RAG Eros). Agregadores são UMA faixa, não o dataset inteiro.",
  "consumer": "Hermes cron / eval. Entrada: export gymsite-consultor-*.json OU POST knowledge-ask / tools do consultor_engine.",
  "export_schema": {
    "file": "gymsite-consultor-{projetoId}-{date}.json",
    "fields": ["exportedAt", "projetoId", "projeto.pesquisas_realizadas", "messages[].role", "messages[].content", "messages[].agenteId", "messages[].acoes", "messages[].citacoes"]
  },
  "pipeline": {
    "especialistas": ["mercado", "tecnico", "regulatorio", "arquiteto", "engenheiro"],
    "pesquisas_mercado": [
      "mercado",
      "demografia",
      "concorrentes",
      "reviews",
      "oferta_concorrentes",
      "pontos_comerciais",
      "investimento"
    ],
    "tools_por_agente": {
      "mercado": [
        "pesquisar_contexto_mercado",
        "analisar_demografia",
        "pesquisar_concorrentes",
        "analisar_reviews_e_dores",
        "mapear_oferta_e_servicos",
        "buscar_pontos_comerciais",
        "estimar_investimento",
        "consultar_base_conhecimento",
        "consultar_base_mercado",
        "consultar_eros_wellhub",
        "consultar_eros_totalpass",
        "consultar_eros_gurupass",
        "consultar_share_agregadores",
        "gerar_relatorio_formal"
      ],
      "tecnico": [
        "consultar_catalogos_equipamentos",
        "dimensionar_cardio_por_pico",
        "dimensionar_musculacao",
        "calcular_equipamentos_por_area",
        "consultar_base_conhecimento"
      ],
      "regulatorio": [
        "resolver_cref_por_uf",
        "consultar_anuidade_pj_cref",
        "consultar_base_conhecimento",
        "consultar_eros_regulatorio"
      ],
      "arquiteto": [
        "consultar_engenharia_obra",
        "calcular_sanitarios_municipio",
        "calcular_sanitarios_por_lotacao"
      ],
      "engenheiro": ["consultar_engenharia_obra", "consultar_eros_engenharia"]
    },
    "eros_groups": {
      "mercado": "MERCADO_GROUP_ID",
      "regulatorio": "REGULATORIO_GROUP_ID",
      "engenheiro": "ENGENHEIRO_GROUP_ID",
      "wellhub": "WELLHUB_GROUP_ID",
      "totalpass": "TOTALPASS_GROUP_ID",
      "gurupass": "GURUPASS_GROUP_ID"
    },
    "rubrica": {
      "tool_vazia": "acoes.status sucesso + citacoes=[] + texto genérico = FALHA (não inventar)",
      "raio_vs_municipio": "0 no raio ≠ 0 no município; deve citar recorte e escalar TP/WH/GP",
      "handoff": "dúvida de outro especialista deve passar bastão (agenteId muda)",
      "citacoes": "carimbo valor·base·fonte·janela quando citar número/norma",
      "relatorio": "gerar_relatorio_formal só se o usuário pedir explicitamente",
      "markdown": "consultor: texto puro (sem * markdown) se regra de produto valer"
    }
  },
